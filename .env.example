# Khóa Gemini API. Có thể điền nhiều khóa cách nhau bằng dấu phẩy (tự đưa vào bảng khóa ở lần chạy đầu)
GEMINI_API_KEY=
# Tên model Gemini (mặc định gemini-3.6-flash)
GEMINI_MODEL=
# Mức suy nghĩ của Gemini 3.x: MINIMAL, LOW, MEDIUM, HIGH (để trống = mặc định của model)
GEMINI_THINKING_LEVEL=
# Số lời gọi Gemini chạy song song (mặc định 4) và số trang PDF mỗi lần gọi (mặc định 8, nên ≤ 10)
GEMINI_CONCURRENCY=
PAGES_PER_CHUNK=
# Số giây chờ (chạy ngầm) trước khi gửi sao kê cho Gemini, để kịp bấm Hủy nếu tải nhầm tệp (mặc định 8)
EXTRACT_START_DELAY_SECONDS=

# Thư mục lưu danh mục, quy tắc, cài đặt theo từng công ty (mặc định data)
DATA_DIR=
# Cổng backend (mặc định 3000) và địa chỉ frontend được phép gọi API (mặc định http://localhost:5173)
PORT=
FRONTEND_ORIGIN=

# PostgreSQL lưu danh sách API key, nhật ký đổi key, tài khoản
# Dạng: postgres://<user>:<mật khẩu>@localhost:5432/tool_sao_ke
DATABASE_URL=

# Đăng nhập Google (OAuth). Tạo tại Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI, ví dụ http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Tài khoản admin: tự tạo / khôi phục quyền admin và đặt lại mật khẩu theo giá trị này mỗi lần khởi động backend (mật khẩu ≥ 8 ký tự)
ADMIN_EMAIL=
ADMIN_PASSWORD=
